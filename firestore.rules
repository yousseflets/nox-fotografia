rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userDoc().role == 'admin';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'client';
      allow create: if isAdmin()
        && request.resource.data.role == 'client';
      allow update, delete: if isAdmin();
    }

    match /albums/{albumId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if isAdmin()
        || (signedIn()
          && get(/databases/$(database)/documents/albums/$(resource.data.albumId)).data.clientId
            == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /portfolioPhotos/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /saleEvents/{eventId} {
      allow get: if resource.data.active == true || isAdmin();
      allow list: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /salePhotos/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
